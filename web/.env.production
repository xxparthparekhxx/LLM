# Production build (`npm run build`). The model file is ~67 MB, over Cloudflare's 25 MiB
# per-file limit, so it is downloaded from Hugging Face and kept in the browser's cache.
#
# Before deploying, upload web/model/model_fp16.onnx to the Hugging Face repo and pin this
# URL to that commit (replace "main" with the commit hash), as the chess page does.
VITE_MODEL_URL=https://huggingface.co/xxparthparekhxx/tinystories-33m/resolve/main/model_fp16.onnx
VITE_MODEL_VERSION=1
