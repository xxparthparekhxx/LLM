# Build-time configuration, copied to .env.local for a custom build.
# See README.md.

# Where the ONNX file is fetched from. The default in dev is /model/model_fp16.onnx,
# served by the dev server from web/model/.
VITE_MODEL_URL=https://huggingface.co/xxparthparekhxx/tinystories-33m/resolve/main/model_fp16.onnx

# Part of the Cache API cache name. Bump it when a new model file is published.
VITE_MODEL_VERSION=1

# Where the WebGPU runtime for browsers without JSPI is loaded from (the bundled JSPI
# build is always used first). Set to an empty string to disable that path.
# VITE_ORT_EXTERNAL_BASE=https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/
